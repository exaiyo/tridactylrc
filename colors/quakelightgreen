/* Keep original quakelight layout */
:root #completions .sectionHeader {
    display: none;
}

:root #tridactyl-colon::before {
    content: "] ";
}

:root #cmdline_iframe {
    position: fixed !important;
    bottom: unset;
    top: 0% !important;
    left: 0% !important;
    box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 15px !important;
}

/* Green hints */
:root {
    --tridactyl-hintspan-bg: #00aa00 !important;
    --tridactyl-hintspan-fg: white !important;
    --tridactyl-hintspan-active-bg: #00cc00 !important;
    --tridactyl-hintspan-active-fg: black !important;
    --tridactyl-hintspan-pressed-fg: #aaffaa !important;

    /* optional – the highlight on the page element itself */
    --tridactyl-hint-bg: rgba(0, 170, 0, 0.25) !important;
    --tridactyl-hint-active-bg: #88ff00 !important;
    --tridactyl-hint-outline: 1px solid #006600 !important;
    --tridactyl-hint-active-outline: 1px solid #00aa00 !important;
}
